{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "recipes",
    "categories",
    "metadata",
    "redirects"
  ],
  "additionalProperties": false,
  "properties": {
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cat",
          "title",
          "mid",
          "year",
          "ingredients",
          "steps",
          "note",
          "photo",
          "scan",
          "continuation",
          "new",
          "author",
          "creditKind",
          "creditLabel",
          "sourceSharer",
          "sourceSharerKind",
          "creditEvidence"
        ],
        "properties": {
          "cat": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "mid": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "creditKind": {
            "type": "string"
          },
          "creditLabel": {
            "type": "string"
          },
          "sourceSharer": {
            "type": "string"
          },
          "sourceSharerKind": {
            "type": "string"
          },
          "creditEvidence": {
            "type": "string"
          },
          "generatedImageNote": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "imageType": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scanExtra": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scan": {
            "type": [
              "string",
              "null"
            ]
          },
          "continuation": {
            "type": "boolean"
          },
          "new": {
            "type": "boolean"
          },
          "generatedImage": {
            "type": "boolean"
          },
          "excelSource": {
            "type": "object",
            "required": [
              "sheet",
              "row"
            ],
            "properties": {
              "sheet": {
                "type": "string"
              },
              "row": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "mid",
                "title"
              ],
              "properties": {
                "mid": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "redirects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
